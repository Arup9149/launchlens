# =============================================================================
# LaunchLens — environment template
# Copy to .env.local for development. Set the same keys in Vercel (or host).
# Never commit real secrets.
# =============================================================================

# --- Required for auth, waitlist, validations, credits ------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — webhooks / credit fulfillment (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# --- Required for correct absolute URLs (auth redirects, payment return) ------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Brain (AI) ---------------------------------------------------------------
# auto | openrouter | ollama
BRAIN_PROVIDER=auto
# Required for cloud Brain on Vercel (no local Ollama)
OPENROUTER_API_KEY=
# Optional model override (default deepseek/deepseek-chat)
OPENROUTER_MODEL=

# --- Payments: India (Razorpay) — required for real INR checkout --------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → secret for /api/payments/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- Payments: International (Stripe) — reserved; not charging yet ------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Transactional email (waitlist welcome, future receipts) ------------------
# Provider: resend | postmark | sendgrid (only resend is implemented today)
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=LaunchLens
# MVP default (verified Resend shared sender). Override after custom domain verify:
# EMAIL_FROM_ADDRESS=team@launchlens.ai
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# Optional override for reply-to
# EMAIL_REPLY_TO=
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Future providers (register adapter in src/lib/email/providers)
# POSTMARK_SERVER_TOKEN=
# SENDGRID_API_KEY=

# --- Admin diagnostics (email_events, etc.) ---------------------------------
# Bearer token for GET /api/admin/email-status
ADMIN_API_SECRET=

# --- Development only ---------------------------------------------------------
# When "true", validate skips the payment gate (Brain report only)
NEXT_PUBLIC_SKIP_PAYMENT=false

# --- Beta payments (default off) ---------------------------------------------
# false | omit = Early Founder Beta (free Founder Validations, no Razorpay)
# true  = enable live checkout (requires Razorpay keys + KYC)
NEXT_PUBLIC_PAYMENT_ENABLED=false
# Optional contact for Builder Pass priority
# NEXT_PUBLIC_FOUNDER_CONTACT_EMAIL=shortlistready@gmail.com
